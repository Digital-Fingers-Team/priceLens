# Environment for the API test suites (apps/api `pnpm test*`). Committed on
# purpose: every value here is a local, throwaway development value.
#
# Tests refuse to run unless DATABASE_URL is a local database whose name ends
# in "_test" (apps/api/test/setup/test-database-guard.ts). The database is
# created by scripts/init-db.sql when the dev stack (docker-compose.yml) first
# starts; apply migrations to it with `pnpm test:db:migrate`.

NODE_ENV=test
DATABASE_URL=postgresql://pricelens:pricelens_dev_password@127.0.0.1:5432/pricelens_test?schema=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=pricelens_redis_dev
# Not the dev stack's 0/1: a test run must not consume the dev API's jobs (B-14).
REDIS_DB=2
REDIS_QUEUE_DB=3

JWT_ACCESS_SECRET=test-access-secret-not-for-production-000000
JWT_REFRESH_SECRET=test-refresh-secret-not-for-production-00000

# Nothing in a test run may reach a real store or paid API.
LIVE_INGESTION_SCHEDULE_ENABLED=false
STORE_COVERAGE_SWEEP_ENABLED=false
CROSS_STORE_BACKFILL_ENABLED=false
RECONCILIATION_SCHEDULE_ENABLED=false
AFFILIATE_CONVERSION_POLL_ENABLED=false
AMAZON_ENABLED=false
ALIBABA_ENABLED=false
ALIEXPRESS_ENABLED=false
NOON_ENABLED=false
JUMIA_ENABLED=false
CARREFOUR_ENABLED=false
TWOB_ENABLED=false
ELARABY_ENABLED=false
FX_RATES_ENABLED=false
OPENROUTER_FALLBACK_ENABLED=false

# No pacing or retry waits against fake connectors (StoreCallGuard).
STORE_MIN_REQUEST_INTERVAL_MS=0
STORE_RETRY_DELAY_MS=0
