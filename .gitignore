# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
coverage/
**/coverage/
.next/
**/.next/
.turbo/

# Environment files
.env
.env.*
!.env.example
!.env.template
!.env.production.example
!.deploy.env.example
**/.env
**/.env.*
!**/.env.example
!**/.env.template
!/.env.production.example
!/.deploy.env.example
# Local throwaway values only (tests refuse any non-local, non-*_test database)
!/.env.test
!/.env.development

# Logs
*.log
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor settings
.vscode/
.idea/
*.key
*.bat

# Prisma
**/prisma/*.db
**/prisma/*.sqlite
**/prisma/*.sqlite3

# Browser automation profiles (hold live retailer login sessions — never commit)
.browser-profiles/
**/.browser-profiles/

# Misc
*.tsbuildinfo

# Local secret material — must never be committed
.admin-seed-credentials
.db-password
.meili-key
.env.bak.*
build-all.sh

# TLS material: private keys and the ACME challenge webroot. Certificates are
# issued on the host, never carried in the repo.
docker/certbot/

# The live web upstream address, written by scripts/deploy-web.sh on every
# deploy. Deliberately untracked: it is machine state, not source, and having
# git able to rewrite it is what took the site down.
docker/nginx-upstreams/*.conf

# Row backups written by apps/api/scripts cleanup/merge jobs (runtime data, not source)
backups/
*.bak
