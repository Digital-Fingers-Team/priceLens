# Local development environment used by `pnpm dev:up` (scripts/dev.sh).
# Committed on purpose: every value is a local, throwaway value matching
# docker-compose.yml. Copy it to .env.development.local (gitignored) and point
# ENV_FILE at that copy if you need to change something privately.
#
# Store connectors, scheduled scraping and paid APIs are OFF so a dev run
# never hits real retailers. To try one store, flip its *_ENABLED flag.
# The full variable reference is .env.example.

NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://pricelens:pricelens_dev_password@127.0.0.1:5432/pricelens_dev?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=pricelens_redis_dev
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=pricelens_meili_dev_key

JWT_ACCESS_SECRET=dev-access-secret-not-for-production-0000000
JWT_REFRESH_SECRET=dev-refresh-secret-not-for-production-000000

LIVE_INGESTION_SCHEDULE_ENABLED=false
STORE_COVERAGE_SWEEP_ENABLED=false
CROSS_STORE_BACKFILL_ENABLED=false
RECONCILIATION_SCHEDULE_ENABLED=false
AFFILIATE_CONVERSION_POLL_ENABLED=false
AMAZON_ENABLED=false
ALIBABA_ENABLED=false
ALIEXPRESS_ENABLED=false
NOON_ENABLED=false
JUMIA_ENABLED=false
CARREFOUR_ENABLED=false
TWOB_ENABLED=false
ELARABY_ENABLED=false
FX_RATES_ENABLED=false
OPENROUTER_FALLBACK_ENABLED=false
