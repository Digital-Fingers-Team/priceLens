# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pricelens:pricelens_dev_password@localhost:5432/pricelens_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pricelens_redis_dev
REDIS_DB=0

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=pricelens_meili_dev_key

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64_DIFFERENT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_LIMIT_AUTH=500

# ─── Embedding / AI (optional) ────────────────────────────────────────────────
# Leave empty to disable semantic matching (falls back to fuzzy only)
OPENAI_API_KEY=

# ─── Scraping ─────────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
SCRAPING_CONCURRENCY=3

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug