{
  "name": "@pricelens/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- jest",
    "test:unit": "dotenv -e ../../.env -- jest --testPathPattern=test/unit --runInBand",
    "test:integration": "dotenv -e ../../.env -- jest --testPathPattern=test/integration",
    "test:e2e": "dotenv -e ../../.env -- jest --config jest.e2e.config.js",
    "test:cov": "dotenv -e ../../.env -- jest --coverage",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "seed:purge-demo": "dotenv -e ../../.env -- ts-node seed/purgeDemoProducts.ts",
    "login:noon": "dotenv -e ../../.env -- ts-node scripts/login-store.ts noon https://www.noon.com/egypt-en/",
    "login:alibaba": "dotenv -e ../../.env -- ts-node scripts/login-store.ts alibaba https://www.alibaba.com/trade/search?SearchText=laptop",
    "login:amazon": "dotenv -e ../../.env -- ts-node scripts/login-store.ts amazon https://www.amazon.com/s?k=laptop"
  },
  "dependencies": {
    "@nestjs/bull": "^10.1.1",
    "@nestjs/cache-manager": "^2.2.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/throttler": "^5.1.1",
    "@prisma/client": "^5.8.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.2",
    "bullmq": "^5.1.0",
    "cache-manager": "^5.3.2",
    "cache-manager-ioredis-yet": "^2.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "compromise": "^14.12.0",
    "date-fns": "^3.2.0",
    "decimal.js": "^10.4.3",
    "express-rate-limit": "^7.1.5",
    "fast-levenshtein": "^3.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "meilisearch": "^0.37.0",
    "natural": "^6.10.4",
    "nest-winston": "^1.9.4",
    "passport": "^0.7.0",
    "patchright": "^1.61.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "pg-copy-streams": "^7.0.0",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0",
    "validator": "^13.15.35",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^4.10.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/natural": "^5.1.4",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prisma": "^5.8.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
