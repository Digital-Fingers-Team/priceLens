// pricelens/apps/api/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "tracing"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), vector, pgTrgm(map: "pg_trgm")]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum MatchStatus {
  ACCEPTED // confidence >= HIGH_THRESHOLD
  PENDING // confidence in [MED_THRESHOLD, HIGH_THRESHOLD)
  REJECTED // confidence < LOW_THRESHOLD
  MANUAL_ACCEPT // human approved in review queue
  MANUAL_REJECT // human rejected in review queue
}

enum AlertType {
  PRICE_DROP_ABSOLUTE // drop by N currency units vs the price when the alert was set
  PRICE_DROP_PERCENT // drop by N% vs the price when the alert was set
  PRICE_TARGET // "tell me when this reaches 12,000 EGP"
  LOWEST_EVER // current best price ties or beats the lowest ever recorded
  PRICE_INCREASE // rose by N% vs the price when the alert was set
  RESTOCK // out-of-stock -> available again
  MAJOR_DISCOUNT // current price is N% below its own trailing median
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  DISABLED
}

// ─── Billing & Entitlements ─────────────────────────────────────────────────

enum PlanTier {
  FREE
  PLUS // B2C premium
  SELLER // B2B retailer
  ENTERPRISE // manufacturer / brand
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  EXPIRED
}

enum NotificationChannelType {
  IN_APP
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ScrapingJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ConnectorType {
  PLAYWRIGHT // browser automation
  HTTP_API // direct API integration
  RSS_FEED // RSS/Atom ingestion
  MANUAL_IMPORT // CSV / manual upload
}

enum ProductTier {
  // Used for category constraints in matching
  BUDGET
  MID_RANGE
  PREMIUM
  ULTRA_PREMIUM
}

// ─── Users & Auth ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique @db.VarChar(32)
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(USER)
  emailVerified Boolean   @default(false) @map("email_verified")
  avatarUrl     String?   @map("avatar_url")
  displayName   String?   @map("display_name") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  deletedAt     DateTime? @map("deleted_at") // soft delete

  sessions             Session[]
  watchlistItems       WatchlistItem[]
  priceAlerts          PriceAlert[]
  reviewDecisions      ReviewDecision[]
  affiliateClicks      AffiliateClick[]
  subscriptions        Subscription[]
  notificationChannels NotificationChannel[]
  notifications        Notification[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token") @db.VarChar(512)
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ─── Categories ─────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(128)
  name        String   @db.VarChar(128)
  parentId    String?  @map("parent_id")
  level       Int      @default(0)
  searchTerms String[] @map("search_terms")
  createdAt   DateTime @default(now()) @map("created_at")

  parent   Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]         @relation("CategoryTree")
  products CanonicalProduct[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// ─── Platforms / Connectors ─────────────────────────────────────────────────

model Platform {
  id            String        @id @default(uuid())
  slug          String        @unique @db.VarChar(64)
  name          String        @db.VarChar(128)
  baseUrl       String        @map("base_url")
  logoUrl       String?       @map("logo_url")
  connectorType ConnectorType @map("connector_type")
  isActive      Boolean       @default(true) @map("is_active")
  rateLimit     Int           @default(60) @map("rate_limit")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  sourceListings  SourceListing[]
  scrapingJobs    ScrapingJob[]
  affiliateConfig AffiliateConfig?
  affiliateClicks AffiliateClick[]

  @@map("platforms")
}

// ─── Canonical Products ──────────────────────────────────────────────────────

model CanonicalProduct {
  id              String  @id @default(uuid())
  categoryId      String  @map("category_id")
  slug            String  @unique
  title           String
  normalizedTitle String  @map("normalized_title")
  brand           String?
  model           String?
  sku             String?
  gtin            String? @unique
  upc             String? @unique
  ean             String? @unique
  mpn             String?

  attributes   Json    @default("{}")
  imageUrl     String? @map("image_url")
  thumbnailUrl String? @map("thumbnail_url")

  titleEmbedding Unsupported("vector(768)")? @map("title_embedding")

  tier        ProductTier @default(MID_RANGE)
  isVerified  Boolean     @default(false) @map("is_verified")
  searchBoost Float       @default(1.0) @map("search_boost")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // When the store-coverage sweep last *attempted* to expand this product.
  // Distinct from updatedAt (which @updatedAt bumps on any write, including
  // ordinary listing refreshes): the sweep needs to know when it last spent
  // scraping effort here, so a product it cannot expand — because no further
  // store actually carries it — is not re-scraped on every single run.
  lastCoverageAttemptAt DateTime? @map("last_coverage_attempt_at")

  category        Category         @relation(fields: [categoryId], references: [id])
  sourceListings  SourceListing[]
  priceHistory    PriceHistory[]
  watchlistItems  WatchlistItem[]
  priceAlerts     PriceAlert[]
  reviewQueues    ReviewQueue[]
  affiliateClicks AffiliateClick[]

  @@index([categoryId])
  @@index([brand, model])
  @@index([gtin])
  @@index([normalizedTitle])
  @@index([lastCoverageAttemptAt])
  @@map("canonical_products")
}

// ─── Source Listings ─────────────────────────────────────────────────────────

model SourceListing {
  id                 String  @id @default(uuid())
  platformId         String  @map("platform_id")
  canonicalProductId String? @map("canonical_product_id")
  externalId         String  @map("external_id")
  externalUrl        String  @map("external_url")

  rawTitle      String   @map("raw_title")
  rawPrice      Decimal? @map("raw_price") @db.Decimal(12, 2)
  rawCurrency   String   @default("USD") @map("raw_currency") @db.VarChar(3)
  rawBrand      String?  @map("raw_brand")
  rawImageUrl   String?  @map("raw_image_url")
  rawAttributes Json     @default("{}") @map("raw_attributes")
  rawCategory   String?  @map("raw_category")

  normalizedTitle     String?  @map("normalized_title")
  extractedGtin       String?  @map("extracted_gtin")
  extractedUpc        String?  @map("extracted_upc")
  extractedEan        String?  @map("extracted_ean")
  extractedMpn        String?  @map("extracted_mpn")
  extractedBrand      String?  @map("extracted_brand")
  extractedModel      String?  @map("extracted_model")
  extractedAttributes Json     @default("{}") @map("extracted_attributes")
  priceUsd            Decimal? @map("price_usd") @db.Decimal(12, 2)
  inStock             Boolean? @map("in_stock")
  rating              Float?
  reviewCount         Int?     @map("review_count")

  matchStatus     MatchStatus @default(PENDING) @map("match_status")
  matchConfidence Float?      @map("match_confidence")
  matchedAt       DateTime?   @map("matched_at")
  matchVersion    Int         @default(1) @map("match_version")

  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  lastScrapedAt DateTime? @map("last_scraped_at")

  platform         Platform          @relation(fields: [platformId], references: [id])
  canonicalProduct CanonicalProduct? @relation(fields: [canonicalProductId], references: [id])
  priceHistory     PriceHistory[]
  matchDecisions   MatchDecision[]
  reviewQueues     ReviewQueue[]
  affiliateClicks  AffiliateClick[]

  @@unique([platformId, externalId])
  @@index([canonicalProductId])
  @@index([matchStatus])
  @@index([normalizedTitle])
  @@index([extractedGtin])
  @@map("source_listings")
}

// ─── Price History ───────────────────────────────────────────────────────────

model PriceHistory {
  id                 String   @id @default(uuid())
  canonicalProductId String   @map("canonical_product_id")
  sourceListingId    String   @map("source_listing_id")
  priceUsd           Decimal  @map("price_usd") @db.Decimal(12, 2)
  currency           String   @default("USD") @db.VarChar(3)
  originalPrice      Decimal? @map("original_price") @db.Decimal(12, 2)
  inStock            Boolean  @default(true) @map("in_stock")
  recordedAt         DateTime @default(now()) @map("recorded_at")

  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  sourceListing    SourceListing    @relation(fields: [sourceListingId], references: [id])

  @@index([canonicalProductId, recordedAt])
  @@index([sourceListingId, recordedAt])
  @@map("price_history")
}

// ─── Match Decision Audit Trail ──────────────────────────────────────────────

model MatchDecision {
  id              String      @id @default(uuid())
  sourceListingId String      @map("source_listing_id")
  candidateId     String?     @map("candidate_id")
  status          MatchStatus
  confidence      Float
  engineVersion   String      @map("engine_version")
  scores          Json
  reasoning       String      @db.Text
  flags           String[]
  processingMs    Int?        @map("processing_ms")
  createdAt       DateTime    @default(now()) @map("created_at")

  sourceListing SourceListing @relation(fields: [sourceListingId], references: [id])

  @@index([sourceListingId])
  @@index([candidateId])
  @@map("match_decisions")
}

// ─── Review Queue ────────────────────────────────────────────────────────────

model ReviewQueue {
  id                 String       @id @default(uuid())
  sourceListingId    String       @map("source_listing_id")
  canonicalProductId String?      @map("canonical_product_id")
  confidence         Float
  scores             Json
  priority           Int          @default(0)
  resolvedAt         DateTime?    @map("resolved_at")
  resolvedBy         String?      @map("resolved_by")
  resolution         MatchStatus?
  notes              String?      @db.Text
  createdAt          DateTime     @default(now()) @map("created_at")

  sourceListing    SourceListing     @relation(fields: [sourceListingId], references: [id])
  canonicalProduct CanonicalProduct? @relation(fields: [canonicalProductId], references: [id])
  reviewDecisions  ReviewDecision[]

  @@index([resolvedAt])
  @@index([priority])
  @@map("review_queue")
}

model ReviewDecision {
  id          String      @id @default(uuid())
  queueItemId String      @map("queue_item_id")
  userId      String      @map("user_id")
  decision    MatchStatus
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  queueItem ReviewQueue @relation(fields: [queueItemId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@map("review_decisions")
}

// ─── Scraping Jobs ───────────────────────────────────────────────────────────

model ScrapingJob {
  id           String            @id @default(uuid())
  platformId   String            @map("platform_id")
  query        String?
  jobType      String            @map("job_type")
  status       ScrapingJobStatus @default(QUEUED)
  priority     Int               @default(0)
  attempts     Int               @default(0)
  maxAttempts  Int               @default(3) @map("max_attempts")
  payload      Json              @default("{}")
  result       Json?
  error        String?           @db.Text
  startedAt    DateTime?         @map("started_at")
  completedAt  DateTime?         @map("completed_at")
  scheduledFor DateTime?         @map("scheduled_for")
  createdAt    DateTime          @default(now()) @map("created_at")

  platform Platform @relation(fields: [platformId], references: [id])

  @@index([platformId, status])
  @@index([status, scheduledFor])
  @@map("scraping_jobs")
}

// Seed generation metadata
model SeedRun {
  id          String    @id @default(uuid())
  profile     String    @db.VarChar(32)
  seedVersion String    @map("seed_version") @db.VarChar(64)
  status      String    @db.VarChar(32)
  config      Json      @default("{}")
  counts      Json      @default("{}")
  error       String?   @db.Text
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  checkpoints SeedCheckpoint[]

  @@index([profile, status])
  @@index([startedAt])
  @@map("seed_runs")
}

model SeedCheckpoint {
  id           String   @id @default(uuid())
  runId        String   @map("run_id")
  stage        String   @db.VarChar(64)
  cursor       Int      @default(0)
  insertedRows BigInt   @default(0) @map("inserted_rows")
  updatedAt    DateTime @updatedAt @map("updated_at")

  run SeedRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stage])
  @@index([stage])
  @@map("seed_checkpoints")
}

// ─── Watchlist & Alerts ──────────────────────────────────────────────────────

model WatchlistItem {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  canonicalProductId String   @map("canonical_product_id")
  note               String?
  createdAt          DateTime @default(now()) @map("created_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id])

  @@unique([userId, canonicalProductId])
  @@index([userId])
  @@map("watchlist_items")
}

model PriceAlert {
  id                 String      @id @default(uuid())
  userId             String      @map("user_id")
  canonicalProductId String      @map("canonical_product_id")
  alertType          AlertType   @map("alert_type")
  thresholdValue     Decimal     @map("threshold_value") @db.Decimal(12, 2)
  status             AlertStatus @default(ACTIVE)
  lastCheckedAt      DateTime?   @map("last_checked_at")
  triggeredAt        DateTime?   @map("triggered_at")
  triggeredPrice     Decimal?    @map("triggered_price") @db.Decimal(12, 2)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // A repeating alert re-arms itself after firing instead of parking in
  // TRIGGERED forever -- which is what a user actually wants from "tell me
  // whenever this drops below X". cooldownHours stops a price oscillating
  // around the threshold from spamming them.
  repeatable     Boolean   @default(false)
  cooldownHours  Int       @default(24) @map("cooldown_hours")
  lastNotifiedAt DateTime? @map("last_notified_at")

  // RESTOCK has to know the stock state we last observed -- without it the
  // very first evaluation of an in-stock product would fire immediately.
  lastSeenInStock Boolean? @map("last_seen_in_stock")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  notifications    Notification[]

  @@index([userId])
  @@index([canonicalProductId, status])
  // The sweep selects ACTIVE alerts ordered by lastCheckedAt; without this it
  // is a full scan + sort of the whole table every 30 minutes.
  @@index([status, lastCheckedAt])
  @@map("price_alerts")
}

// ─── Affiliate System ────────────────────────────────────────────────────────

// Per-store affiliate settings (affiliate/partner ID + extra tracking query
// params to merge into generated links). Link *generation logic* itself lives
// in code (one AffiliateProvider class per store, keyed by providerKey) --
// this table only holds the data half so ops can rotate an affiliate ID
// without a deploy.
model AffiliateConfig {
  id             String   @id @default(uuid())
  platformId     String   @unique @map("platform_id")
  providerKey    String   @map("provider_key") @db.VarChar(64)
  affiliateId    String   @map("affiliate_id")
  trackingParams Json     @default("{}") @map("tracking_params")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@map("affiliate_configs")
}

// One row per "Go to Store" click. id doubles as the click id embedded into
// the generated affiliate URL (e.g. as a subId param) so a later conversion
// postback from the affiliate network can be reconciled back to this row.
model AffiliateClick {
  id                 String   @id @default(uuid())
  sourceListingId    String   @map("source_listing_id")
  canonicalProductId String?  @map("canonical_product_id")
  platformId         String   @map("platform_id")
  userId             String?  @map("user_id")
  ipHash             String   @map("ip_hash")
  userAgent          String?  @map("user_agent")
  affiliateUrl       String   @map("affiliate_url")
  clickedAt          DateTime @default(now()) @map("clicked_at")

  sourceListing    SourceListing         @relation(fields: [sourceListingId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct?     @relation(fields: [canonicalProductId], references: [id], onDelete: SetNull)
  platform         Platform              @relation(fields: [platformId], references: [id], onDelete: Cascade)
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversions      AffiliateConversion[]

  @@index([sourceListingId])
  @@index([canonicalProductId])
  @@index([platformId])
  @@index([userId])
  @@index([clickedAt])
  @@map("affiliate_clicks")
}

enum ConversionStatus {
  PENDING
  APPROVED
  REVERSED
}

// A sale/action reported by an affiliate network (Impact, etc) against a
// click we generated. Matched back to AffiliateClick via clickId -- whatever
// sub-id/click-id value the network's report or postback carries, which our
// AffiliateProvider implementations already embed in the outbound URL (e.g.
// Amazon's ascsubtag, Noon's click_id, Jumia's subid). Note: this only works
// for a given store if that store's *actual* affiliate program is tracked by
// the network in question -- see ConversionProvider / ImpactConversionProvider.
model AffiliateConversion {
  id               String           @id @default(uuid())
  clickId          String           @map("click_id")
  networkKey       String           @map("network_key") @db.VarChar(64)
  externalActionId String           @map("external_action_id")
  status           ConversionStatus @default(PENDING)
  saleAmount       Decimal?         @map("sale_amount") @db.Decimal(12, 2)
  commissionAmount Decimal?         @map("commission_amount") @db.Decimal(12, 2)
  currency         String           @default("USD") @db.VarChar(3)
  occurredAt       DateTime         @map("occurred_at")
  reportedAt       DateTime         @default(now()) @map("reported_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  click AffiliateClick @relation(fields: [clickId], references: [id], onDelete: Cascade)

  @@unique([networkKey, externalActionId])
  @@index([clickId])
  @@index([status])
  @@index([occurredAt])
  @@map("affiliate_conversions")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

// A sellable plan. Prices and limits live in the DB rather than in code so
// pricing can be changed without a deploy (the spec's EGP figures are
// starting points, not constants). `limits` is the single source of truth for
// entitlements -- see EntitlementsService / PLAN_LIMIT_KEYS. A null/absent
// limit means "unlimited"; see DEFAULT_PLAN_BLUEPRINTS for the seeded shape.
model Plan {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(64) // stable code identifier, e.g. "plus_monthly"
  tier        PlanTier
  name        String   @db.VarChar(128)
  description String?  @db.Text

  // Stored in the *minor* unit (piastres) to avoid float money. 0 = free.
  priceMinor   Int    @default(0) @map("price_minor")
  currency     String @default("EGP") @db.VarChar(3)
  intervalDays Int    @default(30) @map("interval_days")

  // Stripe Price id for this plan. Nullable: free plans and hand-sold
  // enterprise contracts never go through Checkout.
  stripePriceId String? @unique @map("stripe_price_id")

  limits      Json    @default("{}") // see PlanLimits
  isActive    Boolean @default(true) @map("is_active")
  isPublic    Boolean @default(true) @map("is_public") // shown on the pricing page
  sortOrder   Int     @default(0) @map("sort_order")
  trialDays   Int     @default(0) @map("trial_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([tier, isActive])
  @@map("plans")
}

// A user's entitlement grant. At most one non-terminal subscription per user
// is enforced by a partial unique index (see the migration) so a user cannot
// stack two paid plans and confuse limit resolution.
model Subscription {
  id     String @id @default(uuid())
  userId String @map("user_id")
  planId String @map("plan_id")

  status SubscriptionStatus @default(ACTIVE)

  // "stripe" for self-serve, "manual" for admin/enterprise grants.
  provider               String  @default("manual") @db.VarChar(32)
  providerCustomerId     String? @map("provider_customer_id")
  providerSubscriptionId String? @unique @map("provider_subscription_id")

  currentPeriodStart DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")
  trialEndsAt        DateTime? @map("trial_ends_at")

  // Per-subscription limit overrides, merged over the plan's limits. This is
  // how an enterprise deal gets a custom product cap without inventing a Plan
  // row per customer.
  limitOverrides Json @default("{}") @map("limit_overrides")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@index([providerCustomerId])
  @@map("subscriptions")
}

// Append-only audit of every entitlement change, including the raw provider
// event. Billing disputes are unanswerable without this.
model SubscriptionEvent {
  id             String   @id @default(uuid())
  subscriptionId String?  @map("subscription_id")
  userId         String?  @map("user_id")
  type           String   @db.VarChar(64) // created | renewed | canceled | payment_failed | plan_changed | manual_grant
  fromPlanKey    String?  @map("from_plan_key") @db.VarChar(64)
  toPlanKey      String?  @map("to_plan_key") @db.VarChar(64)
  provider       String   @default("manual") @db.VarChar(32)
  providerEventId String? @map("provider_event_id")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  // Provider webhooks are at-least-once. This makes replay a no-op instead of
  // a double grant.
  @@unique([provider, providerEventId])
  @@index([subscriptionId])
  @@index([userId, createdAt])
  @@map("subscription_events")
}

// ─── Notifications ───────────────────────────────────────────────────────────

// One row per (user, channel) destination. IN_APP is implicit and always
// present; EMAIL defaults to the account address; TELEGRAM needs an explicit
// verified chat id.
model NotificationChannel {
  id     String                  @id @default(uuid())
  userId String                  @map("user_id")
  type   NotificationChannelType

  // Email address or Telegram chat id. Null for IN_APP.
  destination String? @db.VarChar(255)

  isActive   Boolean   @default(true) @map("is_active")
  verified   Boolean   @default(false)
  // Short-lived code the user pastes to the Telegram bot / clicks in email.
  verifyToken String?  @map("verify_token") @db.VarChar(64)
  verifyExpiresAt DateTime? @map("verify_expires_at")
  verifiedAt DateTime? @map("verified_at")

  lastUsedAt   DateTime? @map("last_used_at")
  failureCount Int       @default(0) @map("failure_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]

  @@unique([userId, type])
  @@index([userId])
  @@index([verifyToken])
  @@map("notification_channels")
}

// The user-visible notification. Also backs the in-app inbox, so it is
// written even when every external channel fails.
model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type  String  @db.VarChar(64) // price_alert.triggered | restock | deal | system | seller.competitor_change
  title String  @db.VarChar(255)
  body  String  @db.Text
  // Deep link into the app, e.g. /products/<slug>.
  url   String?

  // Structured payload (productId, price, threshold, ...) so the frontend can
  // render a rich card without re-parsing the body text.
  data Json @default("{}")

  priceAlertId String? @map("price_alert_id")

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceAlert PriceAlert?            @relation(fields: [priceAlertId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  // The inbox query is "unread first, newest first, for this user".
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// Per-channel send attempt. Separate from Notification so one alert that goes
// to email + Telegram records two independent outcomes and a retry of one
// does not resend the other.
model NotificationDelivery {
  id             String                  @id @default(uuid())
  notificationId String                  @map("notification_id")
  channelId      String?                 @map("channel_id")
  channelType    NotificationChannelType @map("channel_type")

  status       NotificationStatus @default(PENDING)
  attempts     Int                @default(0)
  error        String?            @db.Text
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  notification Notification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel      NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@unique([notificationId, channelType])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}
