// pricelens/apps/api/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "tracing"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), vector, pgTrgm(map: "pg_trgm")]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum MatchStatus {
  ACCEPTED // confidence >= HIGH_THRESHOLD
  PENDING // confidence in [MED_THRESHOLD, HIGH_THRESHOLD)
  REJECTED // confidence < LOW_THRESHOLD
  MANUAL_ACCEPT // human approved in review queue
  MANUAL_REJECT // human rejected in review queue
}

enum AlertType {
  PRICE_DROP_ABSOLUTE // drop by N currency units vs the price when the alert was set
  PRICE_DROP_PERCENT // drop by N% vs the price when the alert was set
  PRICE_TARGET // "tell me when this reaches 12,000 EGP"
  LOWEST_EVER // current best price ties or beats the lowest ever recorded
  PRICE_INCREASE // rose by N% vs the price when the alert was set
  RESTOCK // out-of-stock -> available again
  MAJOR_DISCOUNT // current price is N% below its own trailing median
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  DISABLED
}

// ─── Billing & Entitlements ─────────────────────────────────────────────────

enum PlanTier {
  FREE
  PLUS // B2C premium
  SELLER // B2B retailer
  ENTERPRISE // manufacturer / brand
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  EXPIRED
}

enum NotificationChannelType {
  IN_APP
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ScrapingJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ConnectorType {
  PLAYWRIGHT // browser automation
  HTTP_API // direct API integration
  RSS_FEED // RSS/Atom ingestion
  MANUAL_IMPORT // CSV / manual upload
}

enum ProductTier {
  // Used for category constraints in matching
  BUDGET
  MID_RANGE
  PREMIUM
  ULTRA_PREMIUM
}

// ─── Users & Auth ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique @db.VarChar(32)
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(USER)
  emailVerified Boolean   @default(false) @map("email_verified")
  avatarUrl     String?   @map("avatar_url")
  displayName   String?   @map("display_name") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  deletedAt     DateTime? @map("deleted_at") // soft delete

  sessions             Session[]
  watchlistItems       WatchlistItem[]
  priceAlerts          PriceAlert[]
  reviewDecisions      ReviewDecision[]
  affiliateClicks      AffiliateClick[]
  subscriptions        Subscription[]
  notificationChannels NotificationChannel[]
  notifications        Notification[]
  orgMemberships       OrganizationMember[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token") @db.VarChar(512)
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")
  // Set when the session was revoked by rotating its refresh token, so a
  // later replay of that token can be told apart from a plain logout (S-05).
  rotatedAt    DateTime? @map("rotated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ─── Categories ─────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(128)
  name        String   @db.VarChar(128)
  parentId    String?  @map("parent_id")
  level       Int      @default(0)
  searchTerms String[] @map("search_terms")
  createdAt   DateTime @default(now()) @map("created_at")

  brandWatches BrandWatch[]
  parent   Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]         @relation("CategoryTree")
  products CanonicalProduct[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// ─── Platforms / Connectors ─────────────────────────────────────────────────

model Platform {
  id            String        @id @default(uuid())
  slug          String        @unique @db.VarChar(64)
  name          String        @db.VarChar(128)
  baseUrl       String        @map("base_url")
  logoUrl       String?       @map("logo_url")
  connectorType ConnectorType @map("connector_type")
  isActive      Boolean       @default(true) @map("is_active")
  rateLimit     Int           @default(60) @map("rate_limit")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  sourceListings   SourceListing[]
  scrapingJobs     ScrapingJob[]
  affiliateConfig  AffiliateConfig?
  affiliateClicks  AffiliateClick[]
  organizations    Organization[]
  competitorEvents CompetitorEvent[]

  @@map("platforms")
}

// ─── Canonical Products ──────────────────────────────────────────────────────

model CanonicalProduct {
  id              String  @id @default(uuid())
  categoryId      String  @map("category_id")
  slug            String  @unique
  title           String
  normalizedTitle String  @map("normalized_title")
  brand           String?
  model           String?
  sku             String?
  gtin            String? @unique
  upc             String? @unique
  ean             String? @unique
  mpn             String?

  attributes   Json    @default("{}")
  imageUrl     String? @map("image_url")
  thumbnailUrl String? @map("thumbnail_url")

  titleEmbedding Unsupported("vector(768)")? @map("title_embedding")

  tier        ProductTier @default(MID_RANGE)
  isVerified  Boolean     @default(false) @map("is_verified")
  searchBoost Float       @default(1.0) @map("search_boost")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // When the store-coverage sweep last *attempted* to expand this product.
  // Distinct from updatedAt (which @updatedAt bumps on any write, including
  // ordinary listing refreshes): the sweep needs to know when it last spent
  // scraping effort here, so a product it cannot expand — because no further
  // store actually carries it — is not re-scraped on every single run.
  lastCoverageAttemptAt DateTime? @map("last_coverage_attempt_at")

  category         Category          @relation(fields: [categoryId], references: [id])
  sourceListings   SourceListing[]
  priceHistory     PriceHistory[]
  watchlistItems   WatchlistItem[]
  priceAlerts      PriceAlert[]
  reviewQueues     ReviewQueue[]
  affiliateClicks  AffiliateClick[]
  sellerProducts   SellerProduct[]
  competitorEvents CompetitorEvent[]
  discoveries      ProductDiscovery[]

  @@index([categoryId])
  @@index([brand, model])
  @@index([gtin])
  @@index([normalizedTitle])
  @@index([lastCoverageAttemptAt])
  // Declared so `prisma migrate diff` stops proposing to drop them (B-09);
  // created by migrations 20260605000000 and 20260926100000. Search matches
  // titles with LIKE through the GIN index; reconciliation orders neighbours
  // by trigram distance (<->), which only a GiST index can serve (B-22).
  // The HNSW index on title_embedding cannot be expressed here (Unsupported
  // column); the schema drift test allows exactly that one.
  @@index([normalizedTitle(ops: raw("gin_trgm_ops"))], map: "canonical_products_title_trgm_idx", type: Gin)
  @@index([normalizedTitle(ops: raw("gist_trgm_ops"))], map: "canonical_products_title_trgm_gist_idx", type: Gist)
  @@map("canonical_products")
}

// ─── Source Listings ─────────────────────────────────────────────────────────

model SourceListing {
  id                 String  @id @default(uuid())
  platformId         String  @map("platform_id")
  canonicalProductId String? @map("canonical_product_id")
  externalId         String  @map("external_id")
  externalUrl        String  @map("external_url")

  rawTitle      String   @map("raw_title")
  rawPrice      Decimal? @map("raw_price") @db.Decimal(12, 2)
  rawCurrency   String   @default("USD") @map("raw_currency") @db.VarChar(3)
  rawBrand      String?  @map("raw_brand")
  rawImageUrl   String?  @map("raw_image_url")
  rawAttributes Json     @default("{}") @map("raw_attributes")
  rawCategory   String?  @map("raw_category")

  normalizedTitle     String?  @map("normalized_title")
  extractedGtin       String?  @map("extracted_gtin")
  extractedUpc        String?  @map("extracted_upc")
  extractedEan        String?  @map("extracted_ean")
  extractedMpn        String?  @map("extracted_mpn")
  extractedBrand      String?  @map("extracted_brand")
  extractedModel      String?  @map("extracted_model")
  extractedAttributes Json     @default("{}") @map("extracted_attributes")
  priceUsd            Decimal? @map("price_usd") @db.Decimal(12, 2)

  // The struck-through "was" price the store advertises next to the live one,
  // normalised to the same base currency as priceUsd.
  //
  // Deliberately NOT PriceHistory.originalPrice: despite the name, that column
  // holds the store's raw pre-FX price, which is the same price in another
  // currency rather than a previous one. Fake-discount detection needs a real
  // advertised RRP, and null (no discount claimed) is the honest default --
  // only connectors that can actually read one populate this.
  advertisedPrice     Decimal? @map("advertised_price") @db.Decimal(12, 2)

  inStock             Boolean? @map("in_stock")
  rating              Float?
  reviewCount         Int?     @map("review_count")

  matchStatus     MatchStatus @default(PENDING) @map("match_status")
  matchConfidence Float?      @map("match_confidence")
  matchedAt       DateTime?   @map("matched_at")
  matchVersion    Int         @default(1) @map("match_version")

  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  lastScrapedAt DateTime? @map("last_scraped_at")

  platform         Platform          @relation(fields: [platformId], references: [id])
  canonicalProduct CanonicalProduct? @relation(fields: [canonicalProductId], references: [id])
  priceHistory     PriceHistory[]
  matchDecisions   MatchDecision[]
  reviewQueues     ReviewQueue[]
  affiliateClicks  AffiliateClick[]

  @@unique([platformId, externalId])
  @@index([canonicalProductId])
  @@index([matchStatus])
  @@index([normalizedTitle])
  @@index([extractedGtin])
  @@index([rawTitle(ops: raw("gin_trgm_ops"))], map: "source_listings_raw_title_trgm_idx", type: Gin)
  @@map("source_listings")
}

// ─── Price History ───────────────────────────────────────────────────────────

model PriceHistory {
  id                 String   @id @default(uuid())
  canonicalProductId String   @map("canonical_product_id")
  sourceListingId    String   @map("source_listing_id")
  priceUsd           Decimal  @map("price_usd") @db.Decimal(12, 2)
  // Every write sets it to the base currency; the default only matters if one
  // ever forgets, and then it must not silently mean dollars (L-23, B-15).
  currency           String   @default("EGP") @db.VarChar(3)
  originalPrice      Decimal? @map("original_price") @db.Decimal(12, 2)
  inStock            Boolean  @default(true) @map("in_stock")
  recordedAt         DateTime @default(now()) @map("recorded_at")

  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  sourceListing    SourceListing    @relation(fields: [sourceListingId], references: [id])

  @@index([canonicalProductId, recordedAt])
  @@index([sourceListingId, recordedAt])
  @@index([canonicalProductId, recordedAt, priceUsd], map: "price_history_product_recorded_price_idx")
  @@index([sourceListingId, recordedAt, priceUsd], map: "price_history_listing_recorded_price_idx")
  @@index([recordedAt], map: "price_history_recorded_at_brin_idx", type: Brin)
  @@map("price_history")
}

// ─── Reconciliation merges ───────────────────────────────────────────────────

/// One merge of two canonical products by the reconciliation job, with what
/// is needed to undo it. A merge the code rules made while the AI judge was
/// unavailable has aiVerdict = null; the next run with the judge reviews it and
/// undoes it if the judge says the two were different products.
model ProductMerge {
  id                    String    @id @default(uuid())
  keptProductId         String    @map("kept_product_id")
  mergedProductId       String    @map("merged_product_id")
  keptTitle             String    @map("kept_title")
  mergedTitle           String    @map("merged_title")
  /// The deleted product row, to recreate it on undo.
  mergedSnapshot        Json      @map("merged_snapshot")
  movedListingIds       String[]  @map("moved_listing_ids")
  movedAlertIds         String[]  @map("moved_alert_ids")
  movedReviewItemIds    String[]  @map("moved_review_item_ids")
  movedWatchlistItemIds String[]  @map("moved_watchlist_item_ids")
  /// Users who watched both products; their row on the merged one was deleted.
  droppedWatcherUserIds String[]  @map("dropped_watcher_user_ids")
  /// "ai" (the judge approved) or "rules" (the judge was unavailable).
  decidedBy             String    @map("decided_by") @db.VarChar(16)
  /// null until the AI judge has reviewed the merge.
  aiVerdict             Boolean?  @map("ai_verdict")
  reviewedAt            DateTime? @map("reviewed_at")
  undoneAt              DateTime? @map("undone_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([aiVerdict, undoneAt, createdAt])
  @@index([keptProductId])
  @@map("product_merges")
}

/// The AI judge's answer for one pair of titles, so a pair is asked once.
model MatchJudgement {
  id        String   @id @default(uuid())
  /// sha256 of the two normalized titles, sorted, so (a, b) and (b, a) match.
  pairKey   String   @unique @map("pair_key") @db.VarChar(64)
  titleA    String   @map("title_a")
  titleB    String   @map("title_b")
  same      Boolean
  model     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("match_judgements")
}

// ─── Match Decision Audit Trail ──────────────────────────────────────────────

model MatchDecision {
  id              String      @id @default(uuid())
  sourceListingId String      @map("source_listing_id")
  candidateId     String?     @map("candidate_id")
  status          MatchStatus
  confidence      Float
  engineVersion   String      @map("engine_version")
  scores          Json
  reasoning       String      @db.Text
  flags           String[]
  processingMs    Int?        @map("processing_ms")
  createdAt       DateTime    @default(now()) @map("created_at")

  sourceListing SourceListing @relation(fields: [sourceListingId], references: [id])

  @@index([sourceListingId])
  @@index([candidateId])
  @@map("match_decisions")
}

// ─── Review Queue ────────────────────────────────────────────────────────────

model ReviewQueue {
  id                 String       @id @default(uuid())
  sourceListingId    String       @map("source_listing_id")
  canonicalProductId String?      @map("canonical_product_id")
  confidence         Float
  scores             Json
  priority           Int          @default(0)
  resolvedAt         DateTime?    @map("resolved_at")
  resolvedBy         String?      @map("resolved_by")
  resolution         MatchStatus?
  notes              String?      @db.Text
  createdAt          DateTime     @default(now()) @map("created_at")

  sourceListing    SourceListing     @relation(fields: [sourceListingId], references: [id])
  canonicalProduct CanonicalProduct? @relation(fields: [canonicalProductId], references: [id])
  reviewDecisions  ReviewDecision[]

  @@index([resolvedAt])
  @@index([priority])
  @@map("review_queue")
}

model ReviewDecision {
  id          String      @id @default(uuid())
  queueItemId String      @map("queue_item_id")
  userId      String      @map("user_id")
  decision    MatchStatus
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  queueItem ReviewQueue @relation(fields: [queueItemId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@map("review_decisions")
}

// ─── Scraping Jobs ───────────────────────────────────────────────────────────

model ScrapingJob {
  id           String            @id @default(uuid())
  platformId   String            @map("platform_id")
  query        String?
  jobType      String            @map("job_type")
  status       ScrapingJobStatus @default(QUEUED)
  priority     Int               @default(0)
  attempts     Int               @default(0)
  maxAttempts  Int               @default(3) @map("max_attempts")
  payload      Json              @default("{}")
  result       Json?
  error        String?           @db.Text
  startedAt    DateTime?         @map("started_at")
  completedAt  DateTime?         @map("completed_at")
  scheduledFor DateTime?         @map("scheduled_for")
  createdAt    DateTime          @default(now()) @map("created_at")

  platform Platform @relation(fields: [platformId], references: [id])

  @@index([platformId, status])
  @@index([status, scheduledFor])
  @@map("scraping_jobs")
}

// Seed generation metadata
model SeedRun {
  id          String    @id @default(uuid())
  profile     String    @db.VarChar(32)
  seedVersion String    @map("seed_version") @db.VarChar(64)
  status      String    @db.VarChar(32)
  config      Json      @default("{}")
  counts      Json      @default("{}")
  error       String?   @db.Text
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  checkpoints SeedCheckpoint[]

  @@index([profile, status])
  @@index([startedAt])
  @@map("seed_runs")
}

model SeedCheckpoint {
  id           String   @id @default(uuid())
  runId        String   @map("run_id")
  stage        String   @db.VarChar(64)
  cursor       Int      @default(0)
  insertedRows BigInt   @default(0) @map("inserted_rows")
  updatedAt    DateTime @updatedAt @map("updated_at")

  run SeedRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stage])
  @@index([stage])
  @@map("seed_checkpoints")
}

// ─── Watchlist & Alerts ──────────────────────────────────────────────────────

model WatchlistItem {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  canonicalProductId String   @map("canonical_product_id")
  note               String?
  createdAt          DateTime @default(now()) @map("created_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id])

  @@unique([userId, canonicalProductId])
  @@index([userId])
  @@map("watchlist_items")
}

model PriceAlert {
  id                 String      @id @default(uuid())
  userId             String      @map("user_id")
  canonicalProductId String      @map("canonical_product_id")
  alertType          AlertType   @map("alert_type")
  thresholdValue     Decimal     @map("threshold_value") @db.Decimal(12, 2)
  status             AlertStatus @default(ACTIVE)
  lastCheckedAt      DateTime?   @map("last_checked_at")
  triggeredAt        DateTime?   @map("triggered_at")
  triggeredPrice     Decimal?    @map("triggered_price") @db.Decimal(12, 2)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // A repeating alert re-arms itself after firing instead of parking in
  // TRIGGERED forever -- which is what a user actually wants from "tell me
  // whenever this drops below X". cooldownHours stops a price oscillating
  // around the threshold from spamming them.
  repeatable     Boolean   @default(false)
  cooldownHours  Int       @default(24) @map("cooldown_hours")
  lastNotifiedAt DateTime? @map("last_notified_at")

  // RESTOCK has to know the stock state we last observed -- without it the
  // very first evaluation of an in-stock product would fire immediately.
  lastSeenInStock Boolean? @map("last_seen_in_stock")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  notifications    Notification[]

  @@index([userId])
  @@index([canonicalProductId, status])
  // The sweep selects ACTIVE alerts ordered by lastCheckedAt; without this it
  // is a full scan + sort of the whole table every 30 minutes.
  @@index([status, lastCheckedAt])
  @@map("price_alerts")
}

// ─── Affiliate System ────────────────────────────────────────────────────────

// Per-store affiliate settings (affiliate/partner ID + extra tracking query
// params to merge into generated links). Link *generation logic* itself lives
// in code (one AffiliateProvider class per store, keyed by providerKey) --
// this table only holds the data half so ops can rotate an affiliate ID
// without a deploy.
model AffiliateConfig {
  id             String   @id @default(uuid())
  platformId     String   @unique @map("platform_id")
  providerKey    String   @map("provider_key") @db.VarChar(64)
  affiliateId    String   @map("affiliate_id")
  trackingParams Json     @default("{}") @map("tracking_params")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@map("affiliate_configs")
}

// One row per "Go to Store" click. id doubles as the click id embedded into
// the generated affiliate URL (e.g. as a subId param) so a later conversion
// postback from the affiliate network can be reconciled back to this row.
model AffiliateClick {
  id                 String   @id @default(uuid())
  sourceListingId    String   @map("source_listing_id")
  canonicalProductId String?  @map("canonical_product_id")
  platformId         String   @map("platform_id")
  userId             String?  @map("user_id")
  ipHash             String   @map("ip_hash")
  userAgent          String?  @map("user_agent")
  affiliateUrl       String   @map("affiliate_url")
  clickedAt          DateTime @default(now()) @map("clicked_at")

  sourceListing    SourceListing         @relation(fields: [sourceListingId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct?     @relation(fields: [canonicalProductId], references: [id], onDelete: SetNull)
  platform         Platform              @relation(fields: [platformId], references: [id], onDelete: Cascade)
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversions      AffiliateConversion[]

  @@index([sourceListingId])
  @@index([canonicalProductId])
  @@index([platformId])
  @@index([userId])
  @@index([clickedAt])
  @@map("affiliate_clicks")
}

enum ConversionStatus {
  PENDING
  APPROVED
  REVERSED
}

// A sale/action reported by an affiliate network (Impact, etc) against a
// click we generated. Matched back to AffiliateClick via clickId -- whatever
// sub-id/click-id value the network's report or postback carries, which our
// AffiliateProvider implementations already embed in the outbound URL (e.g.
// Amazon's ascsubtag, Noon's click_id, Jumia's subid). Note: this only works
// for a given store if that store's *actual* affiliate program is tracked by
// the network in question -- see ConversionProvider / ImpactConversionProvider.
model AffiliateConversion {
  id               String           @id @default(uuid())
  clickId          String           @map("click_id")
  networkKey       String           @map("network_key") @db.VarChar(64)
  externalActionId String           @map("external_action_id")
  status           ConversionStatus @default(PENDING)
  saleAmount       Decimal?         @map("sale_amount") @db.Decimal(12, 2)
  commissionAmount Decimal?         @map("commission_amount") @db.Decimal(12, 2)
  currency         String           @default("USD") @db.VarChar(3)
  occurredAt       DateTime         @map("occurred_at")
  reportedAt       DateTime         @default(now()) @map("reported_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  click AffiliateClick @relation(fields: [clickId], references: [id], onDelete: Cascade)

  @@unique([networkKey, externalActionId])
  @@index([clickId])
  @@index([status])
  @@index([occurredAt])
  @@map("affiliate_conversions")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

// A sellable plan. Prices and limits live in the DB rather than in code so
// pricing can be changed without a deploy (the spec's EGP figures are
// starting points, not constants). `limits` is the single source of truth for
// entitlements -- see EntitlementsService / PLAN_LIMIT_KEYS. A null/absent
// limit means "unlimited"; see DEFAULT_PLAN_BLUEPRINTS for the seeded shape.
model Plan {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(64) // stable code identifier, e.g. "plus_monthly"
  tier        PlanTier
  name        String   @db.VarChar(128)
  description String?  @db.Text

  // Stored in the *minor* unit (piastres) to avoid float money. 0 = free.
  priceMinor   Int    @default(0) @map("price_minor")
  currency     String @default("EGP") @db.VarChar(3)
  intervalDays Int    @default(30) @map("interval_days")

  // Stripe Price id for this plan. Nullable: free plans and hand-sold
  // enterprise contracts never go through Checkout.
  stripePriceId String? @unique @map("stripe_price_id")

  limits      Json    @default("{}") // see PlanLimits
  isActive    Boolean @default(true) @map("is_active")
  isPublic    Boolean @default(true) @map("is_public") // shown on the pricing page
  sortOrder   Int     @default(0) @map("sort_order")
  trialDays   Int     @default(0) @map("trial_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([tier, isActive])
  @@map("plans")
}

// A user's entitlement grant. At most one non-terminal subscription per user
// is enforced by a partial unique index (see the migration) so a user cannot
// stack two paid plans and confuse limit resolution.
model Subscription {
  id     String @id @default(uuid())
  userId String @map("user_id")
  planId String @map("plan_id")

  status SubscriptionStatus @default(ACTIVE)

  // "stripe" for self-serve, "manual" for admin/enterprise grants.
  provider               String  @default("manual") @db.VarChar(32)
  providerCustomerId     String? @map("provider_customer_id")
  providerSubscriptionId String? @unique @map("provider_subscription_id")

  currentPeriodStart DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")
  trialEndsAt        DateTime? @map("trial_ends_at")

  // Per-subscription limit overrides, merged over the plan's limits. This is
  // how an enterprise deal gets a custom product cap without inventing a Plan
  // row per customer.
  limitOverrides Json @default("{}") @map("limit_overrides")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@index([providerCustomerId])
  @@map("subscriptions")
}

// Append-only audit of every entitlement change, including the raw provider
// event. Billing disputes are unanswerable without this.
model SubscriptionEvent {
  id             String   @id @default(uuid())
  subscriptionId String?  @map("subscription_id")
  userId         String?  @map("user_id")
  type           String   @db.VarChar(64) // created | renewed | canceled | payment_failed | plan_changed | manual_grant
  fromPlanKey    String?  @map("from_plan_key") @db.VarChar(64)
  toPlanKey      String?  @map("to_plan_key") @db.VarChar(64)
  provider       String   @default("manual") @db.VarChar(32)
  providerEventId String? @map("provider_event_id")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  // Provider webhooks are at-least-once. This makes replay a no-op instead of
  // a double grant.
  @@unique([provider, providerEventId])
  @@index([subscriptionId])
  @@index([userId, createdAt])
  @@map("subscription_events")
}

// ─── Notifications ───────────────────────────────────────────────────────────

// One row per (user, channel) destination. IN_APP is implicit and always
// present; EMAIL defaults to the account address; TELEGRAM needs an explicit
// verified chat id.
model NotificationChannel {
  id     String                  @id @default(uuid())
  userId String                  @map("user_id")
  type   NotificationChannelType

  // Email address or Telegram chat id. Null for IN_APP.
  destination String? @db.VarChar(255)

  isActive   Boolean   @default(true) @map("is_active")
  verified   Boolean   @default(false)
  // Short-lived code the user pastes to the Telegram bot / clicks in email.
  verifyToken String?  @map("verify_token") @db.VarChar(64)
  verifyExpiresAt DateTime? @map("verify_expires_at")
  verifiedAt DateTime? @map("verified_at")

  lastUsedAt   DateTime? @map("last_used_at")
  failureCount Int       @default(0) @map("failure_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]

  @@unique([userId, type])
  @@index([userId])
  @@index([verifyToken])
  @@map("notification_channels")
}

// The user-visible notification. Also backs the in-app inbox, so it is
// written even when every external channel fails.
model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type  String  @db.VarChar(64) // price_alert.triggered | restock | deal | system | seller.competitor_change
  title String  @db.VarChar(255)
  body  String  @db.Text
  // Deep link into the app, e.g. /products/<slug>.
  url   String?

  // Structured payload (productId, price, threshold, ...) so the frontend can
  // render a rich card without re-parsing the body text.
  data Json @default("{}")

  priceAlertId String? @map("price_alert_id")

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceAlert PriceAlert?            @relation(fields: [priceAlertId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  // The inbox query is "unread first, newest first, for this user".
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// Per-channel send attempt. Separate from Notification so one alert that goes
// to email + Telegram records two independent outcomes and a retry of one
// does not resend the other.
model NotificationDelivery {
  id             String                  @id @default(uuid())
  notificationId String                  @map("notification_id")
  channelId      String?                 @map("channel_id")
  channelType    NotificationChannelType @map("channel_type")

  status       NotificationStatus @default(PENDING)
  attempts     Int                @default(0)
  error        String?            @db.Text
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  notification Notification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel      NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@unique([notificationId, channelType])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

// ─── Organizations (seller / brand workspaces) ───────────────────────────────

enum OrgType {
  SELLER // a retailer monitoring competitors
  BRAND // a manufacturer monitoring the market and its distribution
}

enum OrgRole {
  OWNER // billing + members
  ADMIN // full workspace access
  MEMBER // read + acknowledge
}

// A B2B workspace. Entitlements stay on the *owner's* subscription rather than
// being duplicated here: one place decides what a customer may do, which is
// what stops seats and plan limits drifting apart.
model Organization {
  id   String  @id @default(uuid())
  slug String  @unique @db.VarChar(64)
  name String  @db.VarChar(128)
  type OrgType @default(SELLER)

  // Which tracked store is "us", when the seller sells through one we scrape.
  // Null for a seller whose own shop we do not crawl -- they enter prices by
  // hand instead, and competitor comparison still works.
  platformId String? @map("platform_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  platform  Platform?            @relation(fields: [platformId], references: [id], onDelete: SetNull)
  members     OrganizationMember[]
  products    SellerProduct[]
  events      CompetitorEvent[]
  alertRules  CompetitorAlertRule[]
  brandWatches BrandWatch[]
  discoveries ProductDiscovery[]
  reports     MarketReport[]
  apiKeys     ApiKey[]

  @@index([platformId])
  @@map("organizations")
}

model OrganizationMember {
  id     String  @id @default(uuid())
  orgId  String  @map("org_id")
  userId String  @map("user_id")
  role   OrgRole @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

// A product the seller actually sells, mapped onto our canonical catalogue.
//
// The mapping is what makes competitor monitoring possible at all: without a
// canonical product there is nothing to compare against. It is nullable so a
// seller can import their catalogue first and resolve matches afterwards,
// rather than being blocked at upload.
model SellerProduct {
  id    String @id @default(uuid())
  orgId String @map("org_id")

  canonicalProductId String? @map("canonical_product_id")

  sku  String  @db.VarChar(128)
  name String  @db.VarChar(255)

  // Money, in the same normalised base currency as everything else.
  cost         Decimal? @db.Decimal(12, 2)
  currentPrice Decimal? @map("current_price") @db.Decimal(12, 2)

  // Margin targets drive the pricing recommendation. Percentages of price.
  targetMarginPct Float? @map("target_margin_pct")
  minMarginPct    Float? @map("min_margin_pct")

  // Minimum advertised price the brand imposes on this SKU (stage 4).
  mapPrice Decimal? @map("map_price") @db.Decimal(12, 2)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct? @relation(fields: [canonicalProductId], references: [id], onDelete: SetNull)
  events           CompetitorEvent[]

  @@unique([orgId, sku])
  @@index([orgId, isActive])
  @@index([canonicalProductId])
  @@map("seller_products")
}

enum CompetitorEventType {
  PRICE_DROP
  PRICE_INCREASE
  UNDERCUT // a competitor went below the seller's own price
  OUT_OF_STOCK
  BACK_IN_STOCK
  NEW_ENTRANT // a store started carrying this product
  NEW_PRODUCT // a product we had never seen appeared in a watched brand
  UNUSUAL_MOVEMENT // a move far outside this product's normal volatility
  MAP_VIOLATION // advertised below the brand's minimum (stage 4)
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

// An observed competitor change. Append-only: this is the evidence trail
// behind every alert and every report, so rows are never mutated in place.
model CompetitorEvent {
  id    String @id @default(uuid())
  orgId String @map("org_id")

  sellerProductId    String? @map("seller_product_id")
  canonicalProductId String  @map("canonical_product_id")
  // The store the change was observed at.
  platformId         String  @map("platform_id")

  type     CompetitorEventType
  severity EventSeverity       @default(INFO)

  previousPrice Decimal? @map("previous_price") @db.Decimal(12, 2)
  newPrice      Decimal? @map("new_price") @db.Decimal(12, 2)
  changePct     Float?   @map("change_pct")

  /// The seller's own price at detection time, so a report can be rebuilt
  /// later without re-deriving what the market looked like.
  ourPrice Decimal? @map("our_price") @db.Decimal(12, 2)

  /// Evidence: listing url, title, observed stock -- whatever the UI needs to
  /// show *why* we claim this happened.
  evidence Json @default("{}")

  /// Deterministic identity for one observed change, e.g.
  /// "<productId>:<platformId>:PRICE_DROP:2026-09-15".
  ///
  /// An explicit column rather than a unique constraint over detectedAt --
  /// which, defaulting to now(), would differ on every run and dedupe nothing.
  /// A real column also keeps the constraint expressible in the Prisma
  /// datamodel, so a future `migrate diff` cannot propose dropping an index
  /// it does not know about.
  dedupeKey String @map("dedupe_key") @db.VarChar(255)

  detectedAt     DateTime  @default(now()) @map("detected_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by")

  organization     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sellerProduct    SellerProduct?   @relation(fields: [sellerProductId], references: [id], onDelete: SetNull)
  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  platform         Platform         @relation(fields: [platformId], references: [id], onDelete: Cascade)

  // The dashboard reads "newest events for this org", optionally unacknowledged.
  @@index([orgId, detectedAt])
  @@index([orgId, acknowledgedAt])
  @@index([sellerProductId, detectedAt])
  // Detection is idempotent: re-running a sweep must not duplicate an event
  // for the same observed change.
  @@unique([orgId, dedupeKey])
  @@map("competitor_events")
}

// What an org wants to be told about. Absent any rule the detector still
// records events; rules only decide what is worth a notification.
model CompetitorAlertRule {
  id    String @id @default(uuid())
  orgId String @map("org_id")

  type CompetitorEventType

  /// Minimum move, in percent, before this rule fires. Ignored by the types
  /// that are not about price movement.
  thresholdPct Float @default(5) @map("threshold_pct")

  /// Limit the rule to one product, or leave null for the whole catalogue.
  sellerProductId String? @map("seller_product_id")

  isActive      Boolean   @default(true) @map("is_active")
  cooldownHours Int       @default(12) @map("cooldown_hours")
  lastFiredAt   DateTime? @map("last_fired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, type, sellerProductId])
  @@index([orgId, isActive])
  @@map("competitor_alert_rules")
}

// ─── Brand / manufacturer monitoring ─────────────────────────────────────────

// What a brand workspace watches: its own brand, and the competing brands it
// wants tracked alongside. Scoped to a category when a brand only cares about
// part of its range.
model BrandWatch {
  id    String @id @default(uuid())
  orgId String @map("org_id")

  /// Brand name as it appears on canonical products. Matched
  /// case-insensitively, because scraped brand strings are inconsistent.
  brand String @db.VarChar(128)

  /// Narrow the watch to one category. Null watches the brand everywhere.
  categoryId String? @map("category_id")

  /// Ours vs theirs. Distribution and MAP reporting only apply to our own
  /// brand; competitor brands feed the comparison and launch detection.
  isOwnBrand Boolean @default(false) @map("is_own_brand")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([orgId, brand, categoryId])
  @@index([orgId, isActive])
  @@map("brand_watches")
}

// A product we observed for the first time inside a watched brand/category.
//
// Separate from CanonicalProduct.createdAt because "new" is per-workspace:
// a product that predates a brand's subscription is not news to them, and
// each org needs its own notified state.
model ProductDiscovery {
  id    String @id @default(uuid())
  orgId String @map("org_id")

  canonicalProductId String @map("canonical_product_id")

  /// Denormalised so a report can be rendered without rejoining, and stays
  /// truthful even if the product is later re-categorised or re-branded.
  brand        String?  @db.VarChar(128)
  categoryName String?  @map("category_name") @db.VarChar(128)
  firstPrice   Decimal? @map("first_price") @db.Decimal(12, 2)
  firstStore   String?  @map("first_store") @db.VarChar(128)

  /// When PriceLens first saw it, which is the only "new" we can honestly
  /// claim -- it is not necessarily when the product launched.
  firstDetectedAt DateTime  @default(now()) @map("first_detected_at")
  notifiedAt      DateTime? @map("notified_at")

  organization     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@unique([orgId, canonicalProductId])
  @@index([orgId, firstDetectedAt])
  @@map("product_discoveries")
}

enum ReportPeriod {
  WEEKLY
  MONTHLY
}

// A generated market report.
//
// The rendered figures are stored rather than recomputed on open: a report
// dated last Tuesday must keep saying what was true last Tuesday, even after
// prices move. Regenerating it later would quietly rewrite history.
model MarketReport {
  id    String @id @default(uuid())
  orgId String @map("org_id")

  period      ReportPeriod
  periodStart DateTime     @map("period_start")
  periodEnd   DateTime     @map("period_end")

  /// The full rendered report -- see MarketReportPayload in the service.
  payload Json @default("{}")

  generatedAt DateTime @default(now()) @map("generated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // One report per org per period, so a re-run replaces nothing silently.
  @@unique([orgId, period, periodStart])
  @@index([orgId, periodEnd])
  @@map("market_reports")
}

// ─── Enterprise API ──────────────────────────────────────────────────────────

// An API credential belonging to a workspace.
//
// Only a hash of the secret is stored, exactly as for a password: a leaked
// database must not hand over working credentials. The plaintext key is
// returned once, at creation, and never again.
model ApiKey {
  id    String @id @default(uuid())
  orgId String @map("org_id")

  name String @db.VarChar(128)

  /// The public half, shown in the UI so a key can be identified and revoked
  /// without ever displaying the secret (e.g. "pl_live_7f3a").
  keyPrefix String @unique @map("key_prefix") @db.VarChar(32)

  /// SHA-256 of the full key. Not bcrypt: this is verified on every API
  /// request, and a deliberately slow hash would become the rate limit.
  /// The key is 256 bits of CSPRNG output, so it is not brute-forceable the
  /// way a human-chosen password is.
  keyHash String @unique @map("key_hash") @db.VarChar(64)

  /// Coarse permissions, e.g. ["market:read", "events:read"].
  scopes String[] @default([])

  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usage        ApiUsage[]

  @@index([orgId, isActive])
  @@map("api_keys")
}

// Per-key, per-day, per-endpoint call counts.
//
// Aggregated rather than one row per request: an enterprise key at 50k
// calls/day would otherwise write 50k rows a day purely to answer "how many
// calls have you made". The daily rollup is what both the rate limit and the
// usage report actually read.
model ApiUsage {
  id       String @id @default(uuid())
  apiKeyId String @map("api_key_id")
  orgId    String @map("org_id")

  /// Midnight UTC of the day being counted.
  day      DateTime @db.Date
  endpoint String   @db.VarChar(128)

  count        Int @default(0)
  /// Responses that were not 2xx, so a customer debugging an integration can
  /// see their own error rate.
  errorCount   Int @default(0) @map("error_count")

  updatedAt DateTime @updatedAt @map("updated_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, day, endpoint])
  @@index([orgId, day])
  @@map("api_usage")
}
