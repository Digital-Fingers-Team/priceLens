# PriceLens - shared environment variable template for apps/api and apps/web
# Copy this file to .env at the repo root and fill in real values:
#   cp .env.example .env

# ─── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API (apps/api) ──────────────────────────────────────────────────────────
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://pricelens:pricelens_dev_password@localhost:5432/pricelens_dev?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pricelens_redis_dev
REDIS_DB=0
REDIS_URL=redis://:pricelens_redis_dev@localhost:6379/0

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=pricelens_meili_dev_key

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_LIMIT_AUTH=500
LOG_LEVEL=debug

OPENAI_API_KEY=

LIVE_INGESTION_LIMIT=25
LIVE_INGESTION_SCHEDULE_ENABLED=true
LIVE_INGESTION_CRON=0 */6 * * *
# Amazon and Noon sit behind Akamai Bot Manager and block direct (non-proxied) requests —
# disabled by default until a bypass (residential proxy / anti-detect browser) is added back.
AMAZON_ENABLED=false
AMAZON_BASE_URL=https://www.amazon.com
# Alibaba serves an explicit CAPTCHA challenge to automated clients (confirmed even with a
# real headless browser) — disabled until it's reachable through an official partner API.
ALIBABA_ENABLED=false
ALIBABA_BASE_URL=https://www.alibaba.com
NOON_ENABLED=false
NOON_BASE_URL=https://www.noon.com
JUMIA_ENABLED=true
JUMIA_BASE_URL=https://www.jumia.com.eg
# 2B and ELARABY run Magento, whose public storefront GraphQL API serves search results
# (name, price, image, stock) without any bot wall — scraped via that endpoint.
TWOB_ENABLED=true
TWOB_BASE_URL=https://2b.com.eg
ELARABY_ENABLED=true
ELARABY_BASE_URL=https://www.elarabygroup.com
# Carrefour's search endpoint hangs/times out for automated clients (confirmed even with a
# real headless browser) — disabled until it's reachable through an official partner API.
CARREFOUR_ENABLED=false
CARREFOUR_BASE_URL=https://www.carrefouruae.com

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1
