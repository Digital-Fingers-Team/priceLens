# PriceLens - shared environment variable template for apps/api and apps/web
# Copy this file to .env at the repo root and fill in real values:
#   cp .env.example .env

# ─── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API (apps/api) ──────────────────────────────────────────────────────────
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
# Reverse-proxy hops in front of the API whose X-Forwarded-For is trusted
# (rate limiting and session audit use the real client IP). 1 = the nginx proxy.
TRUST_PROXY_HOPS=1

DATABASE_URL=postgresql://pricelens:pricelens_dev_password@localhost:5432/pricelens_dev?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pricelens_redis_dev
REDIS_DB=0
REDIS_URL=redis://:pricelens_redis_dev@localhost:6379/0

# Search runs in Postgres (pg_trgm); there is no separate search engine.
# See docs/adr/0003-search-stays-in-postgres.md.

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_LIMIT_AUTH=500
LOG_LEVEL=debug

OPENAI_API_KEY=

# ─── Semantic matching (OpenRouter) ──────────────────────────────────────────
# Product matching / duplicate reconciliation (embeddings + judgeSameProduct)
# runs entirely via OpenRouter — no local Ollama. This app already needs
# internet access to scrape live retailer sites, and a local small model
# proved both slower (competes for RAM/CPU with everything else running) and
# less reliable at reasoning about model-number/color/storage differences
# than a real cloud model. Call volume here is low enough that the cost is
# negligible. Leave OPENROUTER_API_KEY empty (or set
# OPENROUTER_FALLBACK_ENABLED=false) to disable the LLM path entirely —
# matching then drops to the plain fuzzy-score heuristic, no titles leave the
# host.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MATCH_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_FALLBACK_ENABLED=true

# ─── Duplicate reconciliation job ────────────────────────────────────────────
# Background pass that re-checks EXISTING canonical products for duplicates and
# merges them (fixes products stuck showing "1 store"). Runs on a cron and can
# also be triggered manually via POST /api/v1/admin/reconcile (ADMIN only).
# DRY_RUN=true only logs proposed merges; false actually merges+deletes.
RECONCILIATION_SCHEDULE_ENABLED=true
RECONCILIATION_CRON=0 * * * *
RECONCILIATION_DRY_RUN=false
RECONCILIATION_SIMILARITY_THRESHOLD=0.3
RECONCILIATION_MAX_PAIRS=500
# Nearest neighbours pulled per product (by title-trigram similarity) when
# building the candidate list. Higher = more thorough, more rows to filter.
RECONCILIATION_NEIGHBORS_PER_PRODUCT=8

LIVE_INGESTION_LIMIT=25
# The category-sweep bulk job (all categories x all stores on a cron) is off —
# now that most connectors drive a real browser, that sweep is too slow/heavy
# to run unattended. Products are added/refreshed reactively instead, from
# what users actually type into search (see ProductsService.triggerOnDemandLiveFetch).
# WARNING: in the current code, false ALSO skips scheduling reconciliation, the
# store coverage sweep, price alerts, notification retry, subscription
# maintenance and the brand jobs (workers/ingestion.scheduler.ts). Production
# runs with true. Tracked in audit/00-baseline.md, handoff to phase 03.
LIVE_INGESTION_SCHEDULE_ENABLED=false
LIVE_INGESTION_CRON=0 */6 * * *
# Background job that tops up products stuck under MIN_STORES_PER_PRODUCT (default
# 7) regardless of whether anyone's browsing them. Sequential processing
# (Bull concurrency=1) means a bigger batch extends how much backlog one sweep
# works through, not how much load hits stores at once.
STORE_COVERAGE_SWEEP_ENABLED=true
STORE_COVERAGE_SWEEP_CRON=*/45 * * * *
STORE_COVERAGE_SWEEP_BATCH_SIZE=500
# Target number of distinct stores per product, and how long to wait before
# retrying a product the sweep already tried.
MIN_STORES_PER_PRODUCT=4
STORE_COVERAGE_RETRY_COOLDOWN_HOURS=168
# When a search ingests new products, also look them up at the other stores.
CROSS_STORE_BACKFILL_ENABLED=true
CROSS_STORE_BACKFILL_MAX_PRODUCTS=40
CROSS_STORE_BACKFILL_LIMIT_PER_QUERY=5
# Circuit breaker: a connector that fails this many times in a row is skipped
# for the cooldown period.
CONNECTOR_FAILURE_THRESHOLD=5
CONNECTOR_COOLDOWN_MINUTES=30
# Amazon's bot detection blocks a brand-new automated profile's first visit (503), but a
# real installed Chrome + persistent profile gets through afterward — run
# `npm run login:amazon` once per profile to warm it up. See AmazonConnector.
AMAZON_ENABLED=true
AMAZON_BASE_URL=https://www.amazon.eg
# Alibaba's AWSC risk engine shows a "slide to verify" CAPTCHA to a brand-new automated
# profile, but a human solving it manually ONCE (`npm run login:alibaba`) leaves the
# profile's session trusted for later automated visits — see AlibabaConnector.
ALIBABA_ENABLED=true
ALIBABA_BASE_URL=https://www.alibaba.com
# AliExpress (same parent company as Alibaba) does NOT show that CAPTCHA to the real-Chrome
# + persistent-profile setup, no login required — see AliExpressConnector.
ALIEXPRESS_ENABLED=true
ALIEXPRESS_BASE_URL=https://www.aliexpress.com
# Noon also sits behind Akamai, but NoonConnector drives a real installed Chrome (not
# Playwright's bundled Chromium) through a persistent, logged-in profile instead of parsing
# HTML — see BROWSER_* below. Run `npm run login:noon` once before enabling this.
NOON_ENABLED=true
NOON_BASE_URL=https://www.noon.com
# Where NoonConnector's persistent Chrome profile lives, and whether it launches headless.
# Headless (old or new mode) gets blocked/crashes — on a server, run headed under Xvfb
# instead of setting this to true.
BROWSER_PROFILE_DIR=.browser-profiles
BROWSER_HEADLESS=false
# Chrome/Chromium binary for the browser connectors. Unset = auto-detect.
BROWSER_EXECUTABLE_PATH=
JUMIA_ENABLED=true
JUMIA_BASE_URL=https://www.jumia.com.eg
# 2B and ELARABY run Magento, whose public storefront GraphQL API serves search results
# (name, price, image, stock) without any bot wall — scraped via that endpoint.
TWOB_ENABLED=true
TWOB_BASE_URL=https://2b.com.eg
ELARABY_ENABLED=true
ELARABY_BASE_URL=https://www.elarabygroup.com
# Carrefour UAE isn't actually behind an anti-bot wall — it's a JS-rendered Next.js
# storefront (nothing to scrape without a real browser) whose search param changed from
# ?text= to ?keyword= since this was first written. Works via real Chrome + persistent
# profile on the first visit, no login/CAPTCHA/warm-up needed. See CarrefourConnector.
CARREFOUR_ENABLED=true
CARREFOUR_BASE_URL=https://www.carrefouregypt.com

# ─── Affiliate link tracking ─────────────────────────────────────────────────
# Pepper mixed into the click-tracking IP hash (see AffiliateService) so
# stored hashes can't be reversed back to real IPs from DB access alone.
AFFILIATE_IP_HASH_SALT=change-me-affiliate-salt

# Conversion reconciliation — matches "Go to Store" clicks back to a
# sale/commission reported by an affiliate network (see
# ConversionReconciliationService). Poll runs on a cron regardless of which
# network(s) below are configured; each network no-ops if left blank.
AFFILIATE_CONVERSION_POLL_ENABLED=true
AFFILIATE_CONVERSION_POLL_CRON=0 */2 * * *
# Shared secret appended as ?secret=... to the postback URL you register with
# the network (e.g. https://yourapi.com/api/v1/affiliate/conversions/webhook/impact).
# Required for the inbound webhook route to accept anything.
AFFILIATE_CONVERSION_WEBHOOK_SECRET=

# impact.com Advertiser Actions API — Account SID + Auth Token are under
# app.impact.com > Settings > Technical. Both blank = ImpactConversionProvider
# just logs a warning and skips its poll. Note: Sid on an Impact Action only
# matches an AffiliateClick.id if the store's outbound link actually routes
# through Impact's tracking domain — see the note atop ImpactConversionProvider.
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_API_BASE_URL=https://api.impact.com

# ─── Currency conversion ─────────────────────────────────────────────────────
# Listing prices are normalized to FX_BASE_CURRENCY using a free, keyless
# rates endpoint, cached for FX_RATES_CACHE_TTL_MS (default 12h).
FX_BASE_CURRENCY=EGP
FX_RATES_ENABLED=true
FX_RATES_API_URL=https://open.er-api.com/v6/latest/USD
FX_RATES_CACHE_TTL_MS=43200000

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
# Browser-side API base. Baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1
# Absolute public origin for canonical URLs, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side rendering only: how the web server reaches the API directly
# (in compose, http://api:3001/api/v1). Leave commented out to fall back to
# NEXT_PUBLIC_API_URL -- an empty value would be used as-is.
# API_INTERNAL_URL=http://api:3001/api/v1

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# Entirely optional. Without a secret key the API still runs and every
# entitlement path works — only self-serve checkout is unavailable, and the
# pricing page says so rather than failing at request time. Admins can still
# grant plans by hand via POST /billing/admin/grant.
STRIPE_SECRET_KEY=
# Required for the webhook to be accepted at all: an unverified webhook
# endpoint is an unauthenticated way to grant anyone a paid plan.
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=EGP
BILLING_SUCCESS_PATH=/account/billing?checkout=success
BILLING_CANCEL_PATH=/pricing?checkout=cancelled
BILLING_PORTAL_RETURN_PATH=/account/billing

# ─── Notifications ───────────────────────────────────────────────────────────
# With SMTP_HOST unset the email channel is disabled cleanly: deliveries are
# recorded as SKIPPED rather than FAILED, so an unconfigured deployment does
# not accumulate a backlog of phantom failures.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PriceLens <alerts@pricelens.work.gd>

# Telegram delivery. Create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# Caps notifications per user per hour across all channels — protects users
# from an alert storm (e.g. a scrape glitch moving a thousand prices at once)
# and protects our sending reputation.
NOTIFICATIONS_MAX_PER_USER_PER_HOUR=20
NOTIFICATIONS_MAX_ATTEMPTS=4

# ─── Background job schedules ────────────────────────────────────────────────
PRICE_ALERT_CRON=*/30 * * * *
NOTIFICATION_RETRY_CRON=*/15 * * * *
SUBSCRIPTION_MAINTENANCE_CRON=17 * * * *
COMPETITOR_DETECTION_CRON=45 */3 * * *
MAP_SWEEP_CRON=50 */3 * * *
LAUNCH_DETECTION_CRON=20 */6 * * *
WEEKLY_REPORTS_CRON=0 6 * * 1

# ─── Production compose (docker-compose.server.yml / .prod.yml) ──────────────
# Read by compose to initialise the database and Redis containers.
# DATABASE_URL and REDIS_PASSWORD above must agree with them.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Set to false when running more than one API replica; apply migrations as a
# separate deploy step instead of on container start.
RUN_MIGRATIONS_ON_START=true
