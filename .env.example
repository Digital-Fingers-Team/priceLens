# PriceLens - shared environment variable template for apps/api and apps/web
# Copy this file to .env at the repo root and fill in real values:
#   cp .env.example .env

# ─── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API (apps/api) ──────────────────────────────────────────────────────────
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://pricelens:pricelens_dev_password@localhost:5432/pricelens_dev?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pricelens_redis_dev
REDIS_DB=0
REDIS_URL=redis://:pricelens_redis_dev@localhost:6379/0

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=pricelens_meili_dev_key

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_LIMIT_AUTH=500
LOG_LEVEL=debug

OPENAI_API_KEY=

LIVE_INGESTION_LIMIT=25
# The category-sweep bulk job (all categories x all stores on a cron) is off —
# now that most connectors drive a real browser, that sweep is too slow/heavy
# to run unattended. Products are added/refreshed reactively instead, from
# what users actually type into search (see ProductsService.triggerOnDemandLiveFetch).
LIVE_INGESTION_SCHEDULE_ENABLED=false
LIVE_INGESTION_CRON=0 */6 * * *
# Amazon's bot detection blocks a brand-new automated profile's first visit (503), but a
# real installed Chrome + persistent profile gets through afterward — run
# `npm run login:amazon` once per profile to warm it up. See AmazonConnector.
AMAZON_ENABLED=true
AMAZON_BASE_URL=https://www.amazon.com
# Alibaba's AWSC risk engine shows a "slide to verify" CAPTCHA to a brand-new automated
# profile, but a human solving it manually ONCE (`npm run login:alibaba`) leaves the
# profile's session trusted for later automated visits — see AlibabaConnector.
ALIBABA_ENABLED=true
ALIBABA_BASE_URL=https://www.alibaba.com
# AliExpress (same parent company as Alibaba) does NOT show that CAPTCHA to the real-Chrome
# + persistent-profile setup, no login required — see AliExpressConnector.
ALIEXPRESS_ENABLED=true
ALIEXPRESS_BASE_URL=https://www.aliexpress.com
# Noon also sits behind Akamai, but NoonConnector drives a real installed Chrome (not
# Playwright's bundled Chromium) through a persistent, logged-in profile instead of parsing
# HTML — see BROWSER_* below. Run `npm run login:noon` once before enabling this.
NOON_ENABLED=true
NOON_BASE_URL=https://www.noon.com
# Where NoonConnector's persistent Chrome profile lives, and whether it launches headless.
# Headless (old or new mode) gets blocked/crashes — on a server, run headed under Xvfb
# instead of setting this to true.
BROWSER_PROFILE_DIR=.browser-profiles
BROWSER_HEADLESS=false
JUMIA_ENABLED=true
JUMIA_BASE_URL=https://www.jumia.com.eg
# 2B and ELARABY run Magento, whose public storefront GraphQL API serves search results
# (name, price, image, stock) without any bot wall — scraped via that endpoint.
TWOB_ENABLED=true
TWOB_BASE_URL=https://2b.com.eg
ELARABY_ENABLED=true
ELARABY_BASE_URL=https://www.elarabygroup.com
# Carrefour UAE isn't actually behind an anti-bot wall — it's a JS-rendered Next.js
# storefront (nothing to scrape without a real browser) whose search param changed from
# ?text= to ?keyword= since this was first written. Works via real Chrome + persistent
# profile on the first visit, no login/CAPTCHA/warm-up needed. See CarrefourConnector.
CARREFOUR_ENABLED=true
CARREFOUR_BASE_URL=https://www.carrefouruae.com

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1
