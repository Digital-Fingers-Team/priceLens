{
  "name": "pricelens",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm run build:api && pnpm run build:web",
    "build:web": "pnpm --filter @pricelens/web build",
    "build:api": "pnpm --filter @pricelens/api build",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @pricelens/api dev",
    "dev:web": "pnpm --filter @pricelens/web dev",
    "prestart": "pnpm run build",
    "start": "turbo run start --parallel",
    "start:api": "pnpm --filter @pricelens/api start",
    "start:web": "pnpm --filter @pricelens/web start",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --dir apps/api exec prisma migrate deploy",
    "db:generate": "pnpm --dir apps/api exec prisma generate",
    "db:seed": "pnpm --dir apps/api exec ts-node prisma/seed.ts",
    "db:studio": "pnpm --dir apps/api exec prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "turbo": "^1.13.0",
    "typescript": "^5.3.0",
    "validator": "^13.15.35"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.14.0 <11"
  }
}
