# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS deps

ENV DEBIAN_FRONTEND=noninteractive

# Native dependencies required by some Node packages during pnpm install.
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

WORKDIR /repo

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json

RUN pnpm config set fetch-timeout 600000 && pnpm config set fetch-retries 5

RUN pnpm install --frozen-lockfile --filter @pricelens/web...


FROM node:22-bookworm-slim AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

WORKDIR /repo

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/pnpm-workspace.yaml /repo/package.json /repo/pnpm-lock.yaml ./

COPY apps/web/package.json apps/web/package.json
COPY apps/web apps/web

# NEXT_PUBLIC_* values are compiled into the Next.js client bundle.
# Defaults to a same-origin relative path, NOT a localhost URL. A localhost
# default is baked into the client bundle and then resolves against the
# visitor's own machine, so forgetting --build-arg produced an image that
# built, started and served pages while every API call failed in the browser.
# "/api/v1" is simply correct behind the proxy, and wrong loudly otherwise.
ARG NEXT_PUBLIC_API_URL=/api/v1
ARG NEXT_PUBLIC_SITE_URL=

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}

RUN pnpm --filter @pricelens/web build


FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production

WORKDIR /repo

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=build /repo/pnpm-workspace.yaml /repo/package.json /repo/pnpm-lock.yaml ./
COPY --from=build /repo/apps/web/package.json apps/web/package.json
COPY --from=build /repo/apps/web/.next apps/web/.next
COPY --from=build /repo/apps/web/public apps/web/public
COPY --from=build /repo/apps/web/next.config.js apps/web/next.config.js

RUN NEXT_DIR=$(find /repo/node_modules/.pnpm -maxdepth 3 -type d -path '*/node_modules/next' | head -n 1) && \
    test -n "$NEXT_DIR" && ln -s "$NEXT_DIR" /repo/node_modules/next

RUN chown -R node:node /repo

USER node

WORKDIR /repo/apps/web

EXPOSE 3000

CMD ["node", "/repo/node_modules/next/dist/bin/next", "start", "-p", "3000"]
