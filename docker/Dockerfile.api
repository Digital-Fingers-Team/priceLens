
# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build

ENV DEBIAN_FRONTEND=noninteractive

# Native Node modules such as msgpackr-extract may need Python/build tools.
# Prisma also needs OpenSSL available before its postinstall runs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

WORKDIR /repo

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json

RUN pnpm config set fetch-timeout 600000 && pnpm config set fetch-retries 5

RUN pnpm install --frozen-lockfile --filter @pricelens/api...

COPY apps/api apps/api

# apps/api's build script runs:
# dotenv -e ../../.env -- prisma generate && nest build
# prisma generate only reads the schema, so a placeholder DATABASE_URL is enough.
RUN echo "DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder" > .env

RUN pnpm --filter @pricelens/api build


FROM node:22-bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Runtime dependencies.
#
# AMD64:
#   Install real Google Chrome.
#
# ARM64:
#   Google Chrome's official Linux .deb is AMD64-only,
#   so install Debian Chromium instead.
#
# Xvfb/Fluxbox provide the virtual display.
# x11vnc + noVNC remain available for optional interactive access.

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      wget \
      ca-certificates \
      fonts-liberation \
      openssl \
      xvfb \
      fluxbox \
      x11vnc \
      python3-websockify \
      && \
    ARCH="$(dpkg --print-architecture)" && \
    if [ "$ARCH" = "amd64" ]; then \
      wget -q -O /tmp/chrome.deb \
        https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && \
      apt-get install -y --no-install-recommends /tmp/chrome.deb && \
      rm -f /tmp/chrome.deb; \
    elif [ "$ARCH" = "arm64" ]; then \
      apt-get install -y --no-install-recommends chromium; \
    else \
      echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    wget -q -O /tmp/novnc.tar.gz \
      https://github.com/novnc/noVNC/archive/refs/tags/v1.5.0.tar.gz && \
    mkdir -p /usr/share/novnc && \
    tar -xzf /tmp/novnc.tar.gz \
      -C /usr/share/novnc \
      --strip-components=1 && \
    rm -f /tmp/novnc.tar.gz && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

WORKDIR /repo

COPY --from=build /repo/node_modules /repo/node_modules
COPY --from=build /repo/apps/api /repo/apps/api

WORKDIR /repo/apps/api

COPY docker/entrypoint.api.sh /usr/local/bin/entrypoint.api.sh

RUN chmod +x /usr/local/bin/entrypoint.api.sh

ENV NODE_ENV=production

EXPOSE 3001 6080

ENTRYPOINT ["/usr/local/bin/entrypoint.api.sh"]