
# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build

ENV DEBIAN_FRONTEND=noninteractive

# Native Node modules such as msgpackr-extract may need Python/build tools.
# Prisma also needs OpenSSL available before its postinstall runs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

WORKDIR /repo

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
# Shared type declarations (@pricelens/contracts). Types only, a few KB: the
# whole package is copied so the filtered install can link it.
COPY packages/contracts packages/contracts

RUN pnpm config set fetch-timeout 600000 && pnpm config set fetch-retries 5

RUN pnpm install --frozen-lockfile --filter @pricelens/api...

COPY apps/api apps/api
# The runtime runs as uid 1000 (OPS-19): whatever mode a file has in the
# checkout (a 600 file once broke the in-image tests), it must be readable.
RUN chmod -R a+rX apps/api packages

# apps/api's build script runs:
# dotenv -e ../../.env -- prisma generate && nest build
# prisma generate only reads the schema, so a placeholder DATABASE_URL is enough.
RUN echo "DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder" > .env

RUN pnpm --filter @pricelens/api build


FROM node:22-bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Runtime dependencies.
#
# AMD64:
#   Install real Google Chrome.
#
# ARM64:
#   Google Chrome's official Linux .deb is AMD64-only,
#   so install Debian Chromium instead.
#
# Xvfb/Fluxbox provide the virtual display.
# x11vnc + noVNC remain available for optional interactive access.

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      wget \
      ca-certificates \
      fonts-liberation \
      openssl \
      xvfb \
      fluxbox \
      x11vnc \
      python3-websockify \
      && \
    ARCH="$(dpkg --print-architecture)" && \
    if [ "$ARCH" = "amd64" ]; then \
      wget -q -O /tmp/chrome.deb \
        https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && \
      apt-get install -y --no-install-recommends /tmp/chrome.deb && \
      rm -f /tmp/chrome.deb; \
    elif [ "$ARCH" = "arm64" ]; then \
      apt-get install -y --no-install-recommends chromium; \
    else \
      echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    wget -q -O /tmp/novnc.tar.gz \
      https://github.com/novnc/noVNC/archive/refs/tags/v1.5.0.tar.gz && \
    mkdir -p /usr/share/novnc && \
    tar -xzf /tmp/novnc.tar.gz \
      -C /usr/share/novnc \
      --strip-components=1 && \
    rm -f /tmp/novnc.tar.gz && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

WORKDIR /repo

COPY --from=build /repo/node_modules /repo/node_modules
COPY --from=build /repo/apps/api /repo/apps/api
# Not needed to run the API (type imports are erased), but the unit tests run
# in this image by deploy-api.sh type-check against it.
COPY --from=build /repo/packages/contracts /repo/packages/contracts

WORKDIR /repo/apps/api

COPY docker/entrypoint.api.sh /usr/local/bin/entrypoint.api.sh

RUN chmod +x /usr/local/bin/entrypoint.api.sh

# Run as the image's unprivileged "node" user (uid 1000), not root (audit 10
# OPS-19). What it writes: /tmp (Xvfb, heap snapshots) and the browser
# profiles, a volume mounted over this directory; deploy-api.sh hands an
# existing volume to uid 1000 once. The X socket directory is made here so
# Xvfb does not need root to create it.
RUN mkdir -p /repo/apps/api/.browser-profiles /tmp/.X11-unix \
    && chown node:node /repo/apps/api/.browser-profiles \
    && chmod 1777 /tmp/.X11-unix
USER node

ENV NODE_ENV=production

EXPOSE 3001 6080

ENTRYPOINT ["/usr/local/bin/entrypoint.api.sh"]